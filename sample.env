# Copy to .env and fill in real values. Never commit .env.

SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Full stack in Docker (docker compose up --build): host port and Spring profile for the app container
APP_PORT=8080
APP_PROFILE=stage

# Postgres superuser for the local container (dev only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Application database. In dev the init script creates this user and database.
DB_NAME=acs_payment
DB_USERNAME=acs_payment
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/acs_payment
DB_POOL_MIN_IDLE=0
DB_POOL_MAX_SIZE=10

# Paystack sandbox secret key (also used to verify webhook signatures)
ACS_PAYSTACK_SECRET_KEY=sk_test_change-me
ACS_PAYSTACK_PUBLIC_KEY=pk_test_change-me

# Optional first admin API key, created on startup if missing. Generate one with:
# echo "acs_$(openssl rand -hex 6).$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
ACS_SECURITY_BOOTSTRAP_ADMIN_KEY=

# Any acs.* setting can be overridden the same way, for example:
# ACS_RECONCILIATION_INTERVAL=5m
